---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../consts';
---
<BaseLayout title="Accessibility" description="Accessibility statement for Desai Plastic Surgery.">
  <section class="legal-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Accessibility' }]} />
      <p class="eyebrow">Legal</p>
      <h1>Accessibility statement</h1>
      <p class="lead">We aim to meet WCAG 2.1 AA on every page, and to continue improving.</p>
    </div>
  </section>

  <section class="legal-body section">
    <div class="container">
      <article class="legal-prose">
        <h2>Our commitment</h2>
        <p>Desai Plastic Surgery is committed to providing a website experience that is accessible to all visitors, including people with disabilities.</p>

        <h2>What we've done</h2>
        <ul>
          <li>Semantic HTML structure and ARIA labels on interactive controls</li>
          <li>Full keyboard navigation, including a skip-to-content link</li>
          <li>Visible focus rings on every focusable element</li>
          <li>Respects the user's <em>prefers-reduced-motion</em> setting</li>
          <li>Light and dark themes with palette tokens designed for contrast</li>
          <li>Alt text on meaningful imagery; decorative imagery marked aria-hidden</li>
          <li>Captions and transcripts on featured video where available</li>
        </ul>

        <h2>Known gaps & feedback</h2>
        <p>If you encounter an accessibility barrier on this site, please email
          <a href="mailto:info@desaiplasticsurgery.com">info@desaiplasticsurgery.com</a>
          or call <a href={`tel:${SITE.phoneRaw}`}>{SITE.phone}</a>. We respond within one business day and prioritize accessibility fixes.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-hero { padding: clamp(72px, 10vw, 120px) 0 clamp(48px, 6vw, 64px); background: var(--paper); border-bottom: 1px solid var(--line); }
  .legal-hero .crumbs { margin-bottom: 32px; }
  .legal-hero h1 { margin: 16px 0 20px; font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 260; letter-spacing: -0.04em; }
  .legal-prose { max-width: 64ch; margin: 0 auto; }
  .legal-prose h2 { font-size: 1.4rem; font-weight: 360; letter-spacing: -0.02em; margin: 32px 0 12px; }
  .legal-prose p { color: var(--grey-700); line-height: 1.7; }
  .legal-prose ul { color: var(--grey-700); line-height: 1.85; padding-left: 24px; }
  .legal-prose a { color: var(--ink); border-bottom: 1px solid var(--mauve-deep); padding-bottom: 1px; }
  .legal-prose em { font-style: italic; color: var(--mauve-deep); }
</style>
