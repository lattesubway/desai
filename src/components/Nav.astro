---
import { SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import LocalClock from './LocalClock.astro';
import SocialIcons from './SocialIcons.astro';
import MenuOverlay from './MenuOverlay.astro';
import { Icon } from 'astro-icon/components';
---
<header class="site-header">
  <!-- Utility row — subtle, dim, small caps -->
  <div class="nav-utility">
    <div class="container nav-utility-inner">
      <div class="nu-left">
        <SocialIcons />
        <LocalClock />
      </div>
      <div class="nu-right">
        <a href={`tel:${SITE.phoneRaw}`} class="nav-phone">
          <Icon name="lucide:phone" size={13} aria-hidden="true" />
          <span>{SITE.phone}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main row — three columns, brand centered -->
  <div class="container nav-main">
    <div class="nm-left">
      <MenuOverlay />
      <button type="button" class="search-trigger nm-search" data-search-trigger aria-label="Open search (⌘K)">
        <Icon name="lucide:search" size={15} aria-hidden="true" />
        <span class="nm-search-text">Search</span>
        <kbd>⌘K</kbd>
      </button>
    </div>

    <a href="/" class="brand nm-center" aria-label="Desai Plastic Surgery — Home">
      <img src="/assets/logo.png" alt="Desai Plastic Surgery" class="brand-logo" width="220" height="56" />
    </a>

    <div class="nm-right">
      <ThemeToggle />
      <a href="/consultation" class="btn btn-primary nav-btn">Schedule Consultation</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid var(--line);
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .site-header.scrolled {
    background: color-mix(in oklab, var(--paper) 96%, transparent);
    border-bottom-color: var(--line-strong);
  }

  /* ── Utility row ───────────────────────────────────────── */
  .nav-utility {
    border-bottom: 1px solid var(--line-soft);
  }
  .nav-utility-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    min-height: 36px;
  }
  .nu-left, .nu-right { display: flex; align-items: center; gap: 18px; }
  .nav-phone {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-body); font-size: 0.66rem;
    letter-spacing: 0.22em; color: var(--ink); font-weight: 500;
    text-transform: uppercase; white-space: nowrap;
    transition: opacity .3s var(--ease);
  }
  .nav-phone:hover { opacity: 0.55; }
  .nav-phone svg { color: var(--grey-500); }

  /* ── Main row ──────────────────────────────────────────── */
  .nav-main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 14px 0;
    transition: padding 0.3s var(--ease);
  }
  .site-header.scrolled .nav-main { padding: 10px 0; }
  .nm-left  { display: flex; align-items: center; gap: 22px; justify-self: start; }
  .nm-right { display: flex; align-items: center; gap: 22px; justify-self: end; }
  .nm-center { justify-self: center; display: flex; align-items: center; }

  .brand-logo {
    height: 56px; width: auto;
    filter: grayscale(1) brightness(0) invert(1) brightness(0.95);
    transition: filter 0.3s var(--ease), height 0.3s var(--ease);
  }
  .site-header.scrolled .brand-logo { height: 44px; }
  :global(:root[data-theme="light"]) .brand-logo { filter: grayscale(1) brightness(0); }

  /* Search trigger restyled to include a label */
  .nm-search {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; border: 0; padding: 0; height: 32px;
    color: var(--ink); cursor: pointer;
    font-family: var(--font-body); font-size: 0.68rem;
    letter-spacing: 0.28em; text-transform: uppercase; font-weight: 500;
    transition: opacity .3s var(--ease);
  }
  .nm-search:hover { opacity: 0.55; }
  .nm-search kbd {
    font: 500 10px/1 ui-monospace, monospace;
    background: transparent; border: 1px solid var(--line-strong);
    color: var(--grey-500); padding: 2px 5px; border-radius: 0;
    letter-spacing: 0.04em;
  }

  .nav-btn { padding: 0 0 4px 0 !important; font-size: 0.68rem !important; letter-spacing: 0.28em !important; }

  /* ── Progressive collapse ──────────────────────────────── */
  @media (max-width: 1180px) {
    .nm-search .nm-search-text { display: none; }
  }
  @media (max-width: 980px) {
    .nm-search kbd { display: none; }
    .nav-btn { font-size: 0.64rem !important; }
  }
  @media (max-width: 860px) {
    .nav-utility { display: none; }
    .nav-main { padding: 12px 0; gap: 16px; }
    .brand-logo { height: 44px; }
  }
  @media (max-width: 560px) {
    .nm-left { gap: 14px; }
    .nm-right { gap: 14px; }
    .nav-btn span, .nav-btn { font-size: 0.6rem !important; letter-spacing: 0.22em !important; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 30);
  }, { passive: true });
</script>
